[Unit]
Description=YAM training dashboard and read-only metric mirror
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/condapi
ExecStart=/usr/bin/python3 %h/condapi/scripts/training_dashboard.py --metrics %h/condapi/artifacts/training_dashboard/pi05_rtc_20260916/metrics.jsonl --remote yam-server --remote-metrics /home/wuyan/lyj/YAM/training-runs/pi05_yam/lego_pi05_rtc_base_10h_20260916/metrics/metrics.jsonl --interval 10 --save-interval 1000 --batch-size 32 --stage-steps 30000 --total-steps 30000 --model pi05 --backend OpenPI/JAX --metadata %h/condapi/configs/dashboards/pi05-rtc-metadata.json --name "pi05 · RTC subset 468 / batch32 / target30k"
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
MemoryMax=256M
UMask=0077

[Install]
WantedBy=default.target
